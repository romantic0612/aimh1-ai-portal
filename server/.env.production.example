NODE_ENV=production
PORT=7998
FRONTEND_ORIGIN=https://sjaigc.ahau.edu.cn

SESSION_SECRET=replace-with-a-long-random-secret
SESSION_STORE=mysql
COOKIE_SECURE=true

MYSQL_HOST=replace-with-mysql-host
MYSQL_PORT=3306
MYSQL_USER=replace-with-mysql-user
MYSQL_PASSWORD=replace-with-mysql-password
MYSQL_DATABASE=aimh
MYSQL_POOL_SIZE=15

ADMIN_USER_IDS=replace-with-admin-user-id

OAUTH_AUTH_SERVER=https://replace-with-cas-or-oauth-server
OAUTH_CLIENT_ID=replace-with-client-id
OAUTH_CLIENT_SECRET=replace-with-client-secret
OAUTH_REDIRECT_URI=https://sjaigc.ahau.edu.cn/callback
OAUTH_SCOPE=cas_get_userInfo
OAUTH_USERINFO_ENDPOINT=https://replace-with-userinfo-endpoint

LLM_PLANNER_ENABLED=false
LLM_PLANNER_BASE_URL=https://replace-with-openai-compatible-base-url
LLM_PLANNER_API_KEY=replace-with-api-key
LLM_PLANNER_MODEL=MiniMax-M2.5
LLM_READ_TIMEOUT_MS=120000

DIFY_CONNECT_TIMEOUT=15
DIFY_READ_TIMEOUT=600
DIFY_MAX_CONCURRENT=10
DIFY_BASE_URL=https://replace-with-dify-base-url
DIFY_API_KEY=replace-with-default-dify-key

# Current production business agents: jw, lib, xg.
DIFY_JIAOWU_BASE_URL=https://replace-with-jiaowu-dify-base-url
DIFY_JIAOWU_CHAT_URL=https://replace-with-jiaowu-dify-base-url/v1/chat-messages
DIFY_JIAOWU_API_KEY=replace-with-jiaowu-key
DIFY_JIAOWU_APP_ID=replace-with-jiaowu-app-id
DIFY_RENSHI_BASE_URL=
DIFY_RENSHI_CHAT_URL=
DIFY_RENSHI_API_KEY=
DIFY_RENSHI_APP_ID=
DIFY_LIBRARY_BASE_URL=https://replace-with-library-dify-base-url
DIFY_LIBRARY_CHAT_URL=https://replace-with-library-dify-base-url/v1/chat-messages
DIFY_LIBRARY_API_KEY=replace-with-library-key
DIFY_LIBRARY_APP_ID=replace-with-library-app-id
DIFY_XG_BASE_URL=https://replace-with-xg-dify-base-url
DIFY_XG_CHAT_URL=https://replace-with-xg-dify-base-url/v1/chat-messages
DIFY_XG_API_KEY=replace-with-xg-key
DIFY_XG_APP_ID=replace-with-xg-app-id
